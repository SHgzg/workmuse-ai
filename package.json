{
  "name": "workmuse-ai",
  "version": "0.1.3",
  "description": "A personal AI work assistant for focused, organized daily work",
  "main": "out/main/index.js",
  "author": "SHgzg",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && electron-vite build",
    "runtime:build": "python scripts/build_worker.py",
    "preview": "electron-vite preview",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "dist:ci": "pnpm build && electron-builder --publish never",
    "release": "pnpm build && electron-builder --publish always"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "6.8.9",
    "lucide-react": "^1.34.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "io.github.shgzg.workmuse",
    "productName": "WorkMuse",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "python-worker",
        "to": "python-worker",
        "filter": [
          "**/*.py",
          "**/*.json",
          "**/*.txt"
        ]
      },
      {
        "from": "build/runtime",
        "to": "runtime",
        "filter": [
          "workmuse-worker*"
        ]
      }
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "SHgzg",
      "repo": "workmuse-ai",
      "releaseType": "draft"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "WorkMuse",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "packageManager": "pnpm@10.15.1"
}
